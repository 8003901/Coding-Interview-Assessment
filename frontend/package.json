    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vue-tsc": "^2.2.0"
  }
}
